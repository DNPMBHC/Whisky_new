+- (void)applyExternalCursorShapeData:(NSData *)bgraPixels
+                               width:(NSUInteger)width
+                              height:(NSUInteger)height
+                             hotspot:(CGPoint)hotspot
+                             atPoint:(CGPoint)point
+                             visible:(BOOL)visible {
+    if (width == 0 || height == 0 || width > 128 || height > 128) {
+        return;
+    }
+    NSUInteger expectedBytes = width * height * 4;
+    if (bgraPixels.length < expectedBytes) {
+        return;
+    }
+    NSData *copiedPixels = [bgraPixels copy];
+    [CSMain.sharedInstance asyncWith:^{
+        if (self.hasNativeSpiceCursor) {
+            return;
+        }
+        CGSize newSize = CGSizeMake((CGFloat)width, (CGFloat)height);
+        if (!self.texture || !self.vertices ||
+            !CGSizeEqualToSize(newSize, self.cursorSize) ||
+            !CGPointEqualToPoint(hotspot, self.cursorHotspot)) {
+            [self rebuildCursorWithSize:newSize center:hotspot];
+        }
+        const uint32_t *pixels = (const uint32_t *)copiedPixels.bytes;
+        NSUInteger total = width * height;
+        NSUInteger opaqueCount = 0;
+        NSUInteger nonZeroRGBCount = 0;
+        for (NSUInteger i = 0; i < total; i++) {
+            uint32_t px = pixels[i];
+            if ((px & 0xFF000000u) != 0) {
+                opaqueCount++;
+            }
+            if ((px & 0x00FFFFFFu) != 0) {
+                nonZeroRGBCount++;
+            }
+        }
+        if (opaqueCount == 0 && nonZeroRGBCount > 0) {
+            uint32_t *fixedPixels = (uint32_t *)malloc(total * sizeof(uint32_t));
+            if (fixedPixels != NULL) {
+                for (NSUInteger i = 0; i < total; i++) {
+                    uint32_t px = pixels[i];
+                    fixedPixels[i] = ((px & 0x00FFFFFFu) != 0) ? (px | 0xFF000000u) : 0u;
+                }
+                [self drawCursor:fixedPixels];
+                free(fixedPixels);
+            } else {
+                [self drawCursor:pixels];
+            }
+        } else {
+            [self drawCursor:pixels];
+        }
+        self.usingExternalCursor = YES;
+        self.hasServerCursorMove = YES;
+        self.mouseGuest = point;
+        self.cursorHidden = !visible;
+        cs_cursor_log_probe([NSString stringWithFormat:@"[Malt-Cursor] event=bridge_set size=%lux%lu hot=(%.0f,%.0f) alpha=%lu rgb=%lu/%lu pos=(%.1f,%.1f) vis=%d",
+                             (unsigned long)width, (unsigned long)height,
+                             hotspot.x, hotspot.y,
+                             (unsigned long)opaqueCount, (unsigned long)nonZeroRGBCount, (unsigned long)total,
+                             point.x, point.y, visible ? 1 : 0]);
+        cs_cursor_invalidate(self);
+    }];
+}
+
+- (void)applyExternalCursorMoveTo:(CGPoint)point visible:(BOOL)visible {
+    [CSMain.sharedInstance asyncWith:^{
+        if (self.hasNativeSpiceCursor) {
+            return;
+        }
+        self.usingExternalCursor = YES;
+        self.hasServerCursorMove = YES;
+        self.mouseGuest = point;
+        if (self.hasCursor) {
+            self.cursorHidden = !visible;
+        }
+        cs_cursor_invalidate(self);
+    }];
+}
+
+- (void)hideExternalCursor {
+    [CSMain.sharedInstance asyncWith:^{
+        if (self.hasNativeSpiceCursor) {
+            return;
+        }
+        self.usingExternalCursor = YES;
+        if (!self.cursorHidden) {
+            self.cursorHidden = YES;
+            cs_cursor_log_probe([NSString stringWithFormat:@"[Malt-Cursor] event=bridge_hide pos=(%.1f,%.1f)",
+                                 self.mouseGuest.x, self.mouseGuest.y]);
+            cs_cursor_invalidate(self);
+        }
+    }];
+}
+
 @end
