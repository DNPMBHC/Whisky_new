+static void cs_cursor_log_probe(NSString *line)
+{
+    NSDictionary<NSString *, NSString *> *env = NSProcessInfo.processInfo.environment;
+    NSString *logPath = env[@"UTM_NEPTUNE_PROFILE_LOG"];
+    if (logPath.length == 0 && env[@"UTM_NPT_PROFILE_PERIOD_MS"].integerValue <= 0 && !cs_cursor_debug_enabled()) {
+        return;
+    }
+    NSURL *cachesRoot = [NSFileManager.defaultManager URLsForDirectory:NSCachesDirectory inDomains:NSUserDomainMask].firstObject;
+    NSString *fallbackPath = cachesRoot ? [cachesRoot URLByAppendingPathComponent:@"neptune-latest.log"].path : nil;
+    NSString *primaryPath = logPath.length > 0 ? logPath : fallbackPath;
+    if (primaryPath.length == 0 || line.length == 0) {
+        return;
+    }
+    NSData *payload = [[line stringByAppendingString:@"\n"] dataUsingEncoding:NSUTF8StringEncoding];
+    if (payload.length == 0) {
+        return;
+    }
+    dispatch_async(dispatch_get_global_queue(QOS_CLASS_UTILITY, 0), ^{
+        FILE *fp = fopen(primaryPath.fileSystemRepresentation, "a");
+        if (!fp && fallbackPath.length > 0 && ![fallbackPath isEqualToString:primaryPath]) {
+            fp = fopen(fallbackPath.fileSystemRepresentation, "a");
+        }
+        if (fp) {
+            fwrite(payload.bytes, 1, payload.length, fp);
+            fclose(fp);
+        }
+    });
+}
+
+static BOOL cs_keep_cursor_visible_on_inhibit(void)
+{
+    const char *flag = getenv("UTM_KEEP_CURSOR_VISIBLE_ON_INHIBIT");
