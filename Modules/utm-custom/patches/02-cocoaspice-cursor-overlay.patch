+- (void)applyRelativeFallbackDelta:(CGPoint)delta {
+    if (delta.x == 0 && delta.y == 0) {
+        return;
+    }
+    [CSMain.sharedInstance asyncWith:^{
+        if (self.hasServerCursorMove) {
+            return;
+        }
+        CGSize displaySize = self.display.displaySize;
+        if (displaySize.width <= 0 || displaySize.height <= 0) {
+            return;
+        }
+        CGPoint current = self.mouseGuest;
+        if (!cs_cursor_point_is_valid(current, displaySize)) {
+            current = CGPointMake(displaySize.width / 2.0, displaySize.height / 2.0);
+        }
+        CGFloat nextX = MIN(MAX(current.x + delta.x, 0.0), displaySize.width - 1.0);
+        CGFloat nextY = MIN(MAX(current.y + delta.y, 0.0), displaySize.height - 1.0);
+        self.mouseGuest = CGPointMake(nextX, nextY);
+        cs_cursor_invalidate(self);
+    }];
+}
